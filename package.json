{
	"name": "n8n-nodes-asqav",
	"version": "0.1.1",
	"description": "n8n community node that signs workflow actions with Asqav, producing verifiable compliance receipts.",
	"license": "MIT",
	"homepage": "https://asqav.com",
	"keywords": [
		"n8n-community-node-package",
		"asqav",
		"compliance",
		"audit",
		"agent-governance"
	],
	"author": {
		"name": "Asqav",
		"email": "info@asqav.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jagmarques/n8n-nodes-asqav.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"test": "node --test test/*.test.js",
		"prepublishOnly": "n8n-node prerelease",
		"prepack": "node scripts/bundle-deps.mjs",
		"postpack": "n8n-node build"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/AsqavApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Asqav/Asqav.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"esbuild": "^0.28.2",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "5.9.3",
		"@asqav/sdk": "^0.8.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
